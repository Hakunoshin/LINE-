{
  "name": "personal-line-agent",
  "version": "1.0.0",
  "private": true,
  "description": "自分専用のLINEリマインダー/タスク管理エージェント (Cloudflare Workers)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply personal-line-agent-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply personal-line-agent-db --remote",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "typescript": "^5.6.0",
    "wrangler": "^3.90.0"
  }
}
